      const subject = document.getElementById('emailSubject').innerText;
      const fullText = "Subject: " + subject + "\n\n" + salutation + "\n\n" + content;
      navigator.clipboard.writeText(fullText).then(() => { alert("Draft copied to clipboard!"); });
