      const data = scenarios[key];
      if (!data) return;
      document.getElementById('prospectName').value = data.name;
      document.getElementById('prospectEmail').value = data.email;
      document.getElementById('targetTerritory').value = data.territory;
      document.getElementById('statedBudget').value = data.budget;
      document.getElementById('rawMessage').value = data.message;
      const badge = document.getElementById('tierBadge');
      badge.textContent = data.tier;
      badge.className = "badge " + data.tierClass;
      document.getElementById('scoreVal').textContent = data.score;
      document.getElementById('territoryStatus').textContent = data.territoryStatus;
      document.getElementById('jsonBackground').textContent = data.background;
      document.getElementById('jsonCapital').textContent = data.capital;
      document.getElementById('jsonTimeline').textContent = data.timeline;
      document.getElementById('jsonKit').textContent = data.kit;
      document.getElementById('emailTo').textContent = data.email;
      document.getElementById('emailSubject').textContent = data.subject;
      document.getElementById('emailSalutation').textContent = "Dear " + data.name + ",";
      const emailContainer = document.getElementById('emailContent');
      emailContainer.innerHTML = '';
      data.emailContent.forEach(p => {
        const pElem = document.createElement('p');
        pElem.innerHTML = p;
        emailContainer.appendChild(pElem);
      });
      document.getElementById('attachmentName').textContent = data.kit;
    }

    function runPipeline() {
      const btn = document.getElementById('btnExecute');
      const btnText = document.getElementById('btnText');
      btn.disabled = true;
      btnText.textContent = "Processing Pipeline...";
      for (let i = 1; i <= 4; i++) {
        document.getElementById('dot' + i).className = "trace-dot";
        document.getElementById('time' + i).textContent = "--";
        document.getElementById('traceStep' + i).className = "trace-item";
